CreateNetwork
  argv: ["network" "create" "--driver" "bridge" "--opt" "com.docker.network.bridge.name=br-proj-front" "--ipam-driver" "default" "--subnet" "172.28.0.0/16" "--gateway" "172.28.0.1" "--ip-range" "172.28.5.0/24" "--aux-address" "router=172.28.1.5" "--ipam-opt" "com.example.pool=front" "--internal" "--ipv6" "--label" "com.docker.compose.network=front" "--label" "com.docker.compose.project=proj" "proj_front"]
  warnings:
    networks.proj_front: attachable: ignored (nerdctl has no --attachable)
CreateVolume
  argv: ["volume" "create" "--label" "com.docker.compose.project=proj" "--label" "com.docker.compose.volume=data" "proj_data"]
  warnings:
    volumes.proj_data: driver: ignored (nerdctl has no --driver)
    volumes.proj_data: driver_opts: ignored (nerdctl has no --opt)
BuildImage
  argv: ["build" "-t" "proj-web" "-t" "registry.example.test/proj-web:1.0" "-f" "Dockerfile" "--build-arg" "NGINX_VERSION=1.27" "--target" "runtime" "--label" "org.opencontainers.image.title=web" "--no-cache" "--pull" "--platform" "linux/amd64,linux/arm64" "--cache-from" "type=registry,ref=registry.example.test/proj-web:cache" "--cache-to" "type=inline" "--ssh" "default" "--secret" "id=npmrc,src=/srv/proj/.npmrc" "--network" "host" "--add-host" "db:10.0.0.5" "--build-context" "assets=/srv/proj/assets" "--allow" "security.insecure" "/srv/proj/web"]
  warnings:
    services.web: build.isolation: ignored (nerdctl has no --isolation)
    services.web: build.shm_size: ignored (nerdctl has no --shm-size)
    services.web: build.ulimits: ignored (nerdctl has no --ulimit)
RunContainer
  argv: ["run" "-d" "--name" "proj-web-1" "--platform" "linux/amd64" "--label" "com.docker.compose.container-number=1" "--label" "com.docker.compose.oneoff=False" "--label" "com.docker.compose.project=proj" "--label" "com.docker.compose.project.config_files=/srv/proj/compose.yaml" "--label" "com.docker.compose.project.working_dir=/srv/proj" "--label" "com.docker.compose.service=web" "--annotation" "com.example.owner=platform" "--entrypoint" "/docker-entrypoint.sh" "--workdir" "/usr/share/nginx/html" "--user" "101:101" "-t" "-i" "--init" "--stop-signal" "SIGQUIT" "--stop-timeout" "20" "--env" "NGINX_PORT=80" "--env" "TZ=UTC" "--restart" "unless-stopped" "--network" "bridge" "--hostname" "web" "--domainname" "example.test" "--mac-address" "02:42:ac:1c:00:0a" "--dns" "1.1.1.1" "--dns-search" "example.test" "--dns-option" "ndots:2" "--add-host" "db:10.0.0.5" "-p" "127.0.0.1:8080:80/tcp" "--mount" "type=volume,source=proj_data,target=/data,readonly,volume-nocopy,image-subpath=usr/share,tmpfs-size=67108864,tmpfs-mode=1777" "--tmpfs" "/run" "--shm-size" "67108864" "--volumes-from" "proj-data-1" "--read-only" "--privileged" "--cap-add" "NET_ADMIN" "--cap-drop" "ALL" "--security-opt" "no-new-privileges:true" "--group-add" "audio" "--device" "/dev/fuse:/dev/fuse:rwm" "--gpus" "driver=nvidia,device=0,capabilities=gpu,compute=true" "--sysctl" "net.core.somaxconn=1024" "--ulimit" "nofile=1024:2048" "--pid" "host" "--ipc" "shareable" "--uts" "host" "--userns" "host" "--cgroup-parent" "/compose" "--cgroupns" "private" "--runtime" "runc" "--isolation" "default" "--cpus" "1.5" "--cpu-shares" "512" "--cpuset-cpus" "0-1" "--cpu-period" "100000" "--cpu-quota" "150000" "--cpu-rt-period" "1000000" "--cpu-rt-runtime" "950000" "--memory" "536870912" "--memory-reservation" "268435456" "--memory-swap" "1073741824" "--memory-swappiness" "60" "--oom-kill-disable" "--oom-score-adj" "100" "--pids-limit" "100" "--blkio-weight" "500" "--blkio-weight-device" "/dev/sda:400" "--device-read-bps" "/dev/sda:1048576" "--device-write-bps" "/dev/sda:1048576" "--device-read-iops" "/dev/sda:1000" "--device-write-iops" "/dev/sda:1000" "--no-healthcheck" "--log-driver" "json-file" "--log-opt" "max-file=3" "--log-opt" "max-size=10m" "nginx:1.27" "nginx" "-g" "daemon off;"]
  warnings:
    services.web: cpu_count: ignored (nerdctl has no --cpu-count)
    services.web: cpu_percent: ignored (nerdctl has no --cpu-percent)
    services.web: device_cgroup_rules: ignored (nerdctl has no --device-cgroup-rule)
    services.web: expose: ignored (nerdctl has no --expose)
    services.web: links: ignored (nerdctl has no --link)
    services.web: networks: ignored (network_mode is set)
    services.web: storage_opt: ignored (nerdctl has no --storage-opt)
    services.web: volume_driver: ignored (nerdctl has no --volume-driver)
    services.web: volumes./data.consistency: ignored (not expressible on the command line)
    services.web: volumes./data.volume.labels: ignored (not expressible on the command line)
    services.web: volumes./data.volume.subpath: ignored (nerdctl has no --mount volume-subpath)
StartContainers
  argv: ["start" "proj-web-1"]
  warnings:
StopContainers
  argv: ["stop" "--time" "10" "proj-web-1"]
  warnings:
RemoveContainers
  argv: ["rm" "-f" "-v" "proj-web-1"]
  warnings:
RemoveNetwork
  argv: ["network" "rm" "proj_front"]
  warnings:
RemoveVolume
  argv: ["volume" "rm" "proj_data"]
  warnings:
WaitContainer
  argv: []
  warnings:
ListContainers
  argv: ["ps" "-a" "--no-trunc" "--filter" "label=com.docker.compose.project=proj" "--format" "{{json .}}"]
  warnings:
ListNetworks
  argv: ["network" "ls" "--format" "{{json .}}"]
  warnings:
ListVolumes
  argv: ["volume" "ls" "--format" "{{json .}}"]
  warnings:
ListImages
  argv: ["image" "ls" "--format" "{{json .}}"]
  warnings:
InspectContainer
  argv: ["inspect" "proj-web-1"]
  warnings:
Logs
  argv: ["logs" "-f" "--tail" "10" "proj-web-1"]
  warnings:
