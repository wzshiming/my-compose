podman network create --label com.docker.compose.network=front --label com.docker.compose.project=web edge
podman volume create --label com.docker.compose.project=web --label com.docker.compose.volume=logs nginx-logs
podman volume create --label com.docker.compose.project=web --label com.docker.compose.volume=data web_data
podman run -d --name web-db-1 --label com.docker.compose.container-number=1 --label com.docker.compose.oneoff=False --label com.docker.compose.project=web --label com.docker.compose.project.config_files=<DIR>/compose.yaml --label com.docker.compose.project.working_dir=<DIR> --label com.docker.compose.service=db --env POSTGRES_PASSWORD=secret --network back --network-alias db --mount type=volume,source=web_data,target=/var/lib/postgresql/data --health-cmd 'pg_isready -U postgres' --health-interval 10s --health-timeout 5s --health-start-period 30s --health-retries 5 postgres:16
# wait for web-db-1: healthy
podman run -d --name web-web-1 --label com.docker.compose.container-number=1 --label com.docker.compose.oneoff=False --label com.docker.compose.project=web --label com.docker.compose.project.config_files=<DIR>/compose.yaml --label com.docker.compose.project.working_dir=<DIR> --label com.docker.compose.service=web --restart unless-stopped --network back --network-alias web --network edge -p 127.0.0.1:8080:80/tcp -p 8443:443/tcp --mount type=volume,source=nginx-logs,target=/var/log/nginx nginx:1.27
